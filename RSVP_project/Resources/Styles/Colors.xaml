<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Clean white + purple palette. No grays: "muted" text/placeholders use
         SecondaryDarkText (a mid purple) and washed-out/disabled states use
         Secondary (a pale lavender) instead of a gray scale. -->

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#2B0B98</Color>
    <Color x:Key="Secondary">#EDE7FB</Color>
    <Color x:Key="SecondaryDarkText">#8570D6</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <!-- The one gradient, reused everywhere something needs "the purple
         gradient": primary buttons and page/section headers. -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#512BD4" Offset="0.0" />
        <GradientStop Color="#2B0B98" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
