<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AssessmentApp.ViewModels"
             x:Class="AssessmentApp.MainPage"
             x:DataType="vm:LoginViewModel"
             Title="Login">
    <ScrollView>
        <VerticalStackLayout Padding="28,48" Spacing="16">
            <Label Text="{Binding DisplayName}" Style="{StaticResource Headline}" />
            <Label Text="Wk 4 Performance Assessment" Style="{StaticResource SubHeadline}" />
            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" Margin="0,8,0,12" />
            <Label Text="User Name" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Username}" Placeholder="Lawson01" />
            <Label Text="Password" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Password1" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                <Button Text="Login" Command="{Binding LoginCommand}" />
                <Button Grid.Column="1" Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Message}" TextColor="{StaticResource ErrorColor}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>