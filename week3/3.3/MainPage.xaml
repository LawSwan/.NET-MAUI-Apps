<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ItemCatalog.MainPage"
             Title="Item Catalog">
    <Grid RowDefinitions="Auto,*" Padding="24" RowSpacing="18">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="12">
                <Label Text="Item Catalog"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#17324D" />
                <Label Text="Your Name"
                       FontSize="16"
                       TextColor="#52606D" />
                <Label Text="Please provide the following information:"
                       Margin="0,6,0,8"
                       FontSize="16" />

                <Label Text="Item ID" FontAttributes="Bold" />
                <Entry x:Name="ItemIdEntry"
                       Placeholder="Enter item ID"
                       Keyboard="Text"
                       ClearButtonVisibility="WhileEditing" />

                <Label Text="Item Name" FontAttributes="Bold" />
                <Entry x:Name="ItemNameEntry"
                       Placeholder="Enter item name"
                       ClearButtonVisibility="WhileEditing" />

                <Label Text="Item Description" FontAttributes="Bold" />
                <Editor x:Name="ItemDescriptionEditor"
                        Placeholder="Enter item description"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="90" />

                <Button Text="Save"
                        Clicked="OnSaveClicked"
                        BackgroundColor="#167D8D"
                        TextColor="White"
                        FontAttributes="Bold"
                        Margin="0,6,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Label Text="Stored Items"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#17324D" />
            <CollectionView x:Name="ItemsCollectionView"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No items have been added yet."
                           TextColor="#52606D"
                           HorizontalOptions="Center"
                           Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="#D9E2EC"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12"
                                Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding ItemId, StringFormat='ID: {0}'}"
                                       FontAttributes="Bold"
                                       TextColor="#17324D" />
                                <Label Text="{Binding Name, StringFormat='Name: {0}'}" />
                                <Label Text="{Binding Description, StringFormat='Description: {0}'}"
                                       TextColor="#52606D" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
